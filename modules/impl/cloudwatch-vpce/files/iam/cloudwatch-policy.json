{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowCreateAndWriteLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogStream",
                "logs:DescribeLogStreams",
                "logs:PutLogEvents"
            ],
            "Resource": [
                "arn:aws:logs:*:*:log-group:/aws/vpce-test/*",
                "arn:aws:logs:*:*:log-group:/aws/vpce-test/*:log-stream:*"
            ]
        }
    ]
}