{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowOnlyTestLogGroupViaEndpoint",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::${account_id}:root"
            },
            "Action": [
                "logs:CreateLogStream",
                "logs:DescribeLogStreams",
                "logs:PutLogEvents"
            ],
            "Resource": [
                "${log_group_arn}",
                "${log_group_arn}:log-stream:*"
            ]
        }
    ]
}