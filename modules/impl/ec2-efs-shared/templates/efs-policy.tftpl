{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowMountFromApprovedPrincipals",
      "Effect": "Allow",
      "Principal": {
        "AWS": ${ec2_role_arns_json}
      },
      "Action": [
        "elasticfilesystem:ClientWrite",
        "elasticfilesystem:ClientMount"
      ],
      "Resource": "${efs_resource}",
      "Condition": {
        "Bool": {
          "elasticfilesystem:AccessedViaMountTarget": "true"
        }
      }
    }
  ]
}
